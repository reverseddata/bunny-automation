# Copy to .env (never commit it) and fill in. The server reads environment
# variables; load this file with your process manager or `set -a; . ./.env`.

# Your Bhopp login token: bhopp.com -> F12 -> Console -> localStorage.getItem("bhopp.token")
# It expires after 7 days. Either put it here, or point BHOPP_TOKEN_FILE at a
# file holding it (re-read on every call, so you can swap it without a restart).
BHOPP_TOKEN=
# BHOPP_TOKEN_FILE=/path/to/bhopp_token

# Key your own bot sends in the X-API-Key header. Make it long and random:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BUNNY_API_KEY=

# Where events (new order, confirmed, human, ...) are POSTed. Optional.
BUNNY_WEBHOOK_URL=
# Signs each webhook body (HMAC-SHA256, header X-Bunny-Signature). Optional but recommended.
BUNNY_WEBHOOK_SECRET=

# Names used in the chat texts, and your private server link for autodelivery.
BUNNY_SELLER_NAME=YourName
BUNNY_TRADER=YourTradeBot
BUNNY_SERVER_LINK=https://www.roblox.com/share?code=...&type=Server

# Minimum order in cents (500 = $5). 0 = off. Orders below it get one message
# and the event order.below_minimum; cancelling or delivering is up to you.
BUNNY_MIN_ORDER_CENTS=0

# The automatic order chat, and staying shown online on Bhopp.
BUNNY_FLOW=on
BUNNY_PRESENCE=on
BUNNY_POLL_S=15

# Your own chat texts (JSON file of {"key": "text"}), see bunny/chat.py. Optional.
# BUNNY_TEXTS_FILE=texts.json

BUNNY_DB=bunny.sqlite
